#!/usr/bin/env bash
# Centralized, pinned versions for reproducible wasm builds.

EMSDK_VERSION=3.1.74
QT_VERSION=5.15.2
QT_SRC_URL=https://download.qt.io/archive/qt/5.15/5.15.2/single/qt-everywhere-src-5.15.2.tar.xz
QT_SRC_DIR=qt-everywhere-src-5.15.2

# Default memory sizing (override via qmake vars if needed).
# Keep below 2GB to satisfy wasm32 limits (2GB - 64KiB).
KONCLUDE_WASM_TOTAL_MEMORY=2147418112   # 2GB minus 64KiB

# Default pthread pool size for wasm builds (override as needed).
# Use "auto" to size at runtime from navigator.hardwareConcurrency.
KONCLUDE_WASM_PTHREAD_POOL=auto
# Extra pthread workers to leave room for Konclude's internal threads.
KONCLUDE_WASM_PTHREAD_OVERHEAD=0

# Default Konclude processor count for wasm (controls internal task workers).
# Leave empty to use all detected cores at runtime; override with an integer if needed.
KONCLUDE_WASM_PROCESSOR_COUNT=

# Set to 2 to fail fast if the pool is too small (debug/testing only).
KONCLUDE_WASM_PTHREAD_STRICT=0

# Enable extra wasm debug helpers (ASSERTIONS/DEMANGLE/line tables).
KONCLUDE_WASM_DEBUG=0

# Enable link-time optimization (LTO) for release builds.
KONCLUDE_WASM_LTO=0

# Enable -O3 on the link step (disabled by default; can break pthread runtime on emsdk 3.1.74).
KONCLUDE_WASM_LINK_O3=0

# Enable SIMD for supported browsers (build will fail to load on non-SIMD runtimes).
KONCLUDE_WASM_SIMD=1

# Increase wasm stack size for deep reasoning workloads.
KONCLUDE_WASM_STACK_SIZE=67108864   # 64MB
# Increase pthread stack size for deep reasoning workloads.
KONCLUDE_WASM_PTHREAD_STACK_SIZE=33554432   # 32MB

# Allocator (emscripten MALLOC). Supported values depend on emsdk version.
KONCLUDE_WASM_MALLOC=mimalloc

# Allow wasm function table growth (set to 1 if indirect call OOBs appear).
KONCLUDE_WASM_TABLE_GROWTH=0

# Allow emulated function pointer casts (set to 1 if required by callbacks).
KONCLUDE_WASM_FP_CASTS=0

# Thread reserve policy: 0=default, 1=relaxed, 2=none (max workers).
KONCLUDE_WASM_RESERVE_POLICY=1

# Enable C++ exception support for WASM (set to 0 to disable).
KONCLUDE_WASM_EXCEPTIONS=1
# Use native WebAssembly exceptions (requires emsdk 3.x + modern browsers).
KONCLUDE_WASM_WASM_EXCEPTIONS=1
# Longjmp mode for Qt 5.15 builds: wasm (requires Qt rebuilt with wasm exceptions).
KONCLUDE_WASM_LONGJMP=wasm
