#!/usr/bin/env bash
# Centralized, pinned versions for reproducible wasm builds.

EMSDK_VERSION=1.39.8
QT_VERSION=5.15.2
QT_SRC_URL=https://download.qt.io/archive/qt/5.15/5.15.2/single/qt-everywhere-src-5.15.2.tar.xz
QT_SRC_DIR=qt-everywhere-src-5.15.2

# Default memory sizing (override via qmake vars if needed).
KONCLUDE_WASM_TOTAL_MEMORY=1610612736   # 1.5GB

# Default pthread pool size for wasm builds (override as needed).
# Use "auto" to size the pool at runtime via navigator.hardwareConcurrency.
KONCLUDE_WASM_PTHREAD_POOL=auto
# Extra pthread workers to leave room for Konclude's internal threads.
KONCLUDE_WASM_PTHREAD_OVERHEAD=16

# Default Konclude processor count for wasm (controls internal task workers).
# Leave empty to use all detected cores at runtime; override with an integer if needed.
KONCLUDE_WASM_PROCESSOR_COUNT=

# Set to 2 to fail fast if the pool is too small (debug/testing only).
KONCLUDE_WASM_PTHREAD_STRICT=0

# Enable extra wasm debug helpers (ASSERTIONS/DEMANGLE/line tables).
KONCLUDE_WASM_DEBUG=0

# Increase wasm stack size for deep reasoning workloads.
KONCLUDE_WASM_STACK_SIZE=67108864   # 64MB

# Enable C++ exception support for WASM (set to 0 to disable).
KONCLUDE_WASM_EXCEPTIONS=1
