Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(first:=<http://www.w3.org/2002/03owlt/TransitiveProperty/premises002#>)
Prefix(second:=<http://www.w3.org/2002/03owlt/TransitiveProperty/conclusions002#>)


Ontology(
Declaration(ObjectProperty(first:symProp))
Declaration(NamedIndividual(first:a))
############################
#   Object Properties
############################

# Object Property: first:symProp (first:symProp)

TransitiveObjectProperty(first:symProp)



############################
#   Named Individuals
############################

# Individual: first:a (first:a)

ClassAssertion(ObjectSomeValuesFrom(first:symProp owl:Thing) first:a)


)