  &lt;/rdf:Description&gt;
  &lt;rdf:Description rdf:about="http://www.example.org#o2"&gt;
    &lt;owl:sameAs rdf:resource="http://www.example.org#o1"/&gt;
  &lt;/rdf:Description&gt;
