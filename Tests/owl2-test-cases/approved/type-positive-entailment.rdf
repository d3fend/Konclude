  &lt;rdf:Description rdf:about="http://www.example.org#s1"&gt;
    &lt;ex:p2 rdf:resource="http://www.example.org#o1"/&gt;
    &lt;ex:p1 rdf:resource="http://www.example.org#o2"/&gt;
  &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
