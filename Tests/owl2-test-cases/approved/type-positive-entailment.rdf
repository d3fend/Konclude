  &lt;rdf:Description rdf:about="http://www.example.org#d1"&gt;
    &lt;rdfs:subClassOf rdf:resource="http://www.example.org#c2"/&gt;
  &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
