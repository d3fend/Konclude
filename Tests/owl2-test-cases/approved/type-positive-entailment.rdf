  &lt;ex:x rdf:about="http://www.example.org#z"/&gt;
  &lt;rdf:Description rdf:about="http://www.example.org#c"&gt;
    &lt;owl:unionOf rdf:parseType="Collection"&gt;
      &lt;rdf:Description rdf:about="http://www.example.org#x"/&gt;
