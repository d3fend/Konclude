	<test:TestCase rdf:about="http://owl.semanticweb.org/id/Somevaluesfrom2bnode">
		<rdf:type rdf:resource="&test;ProfileIdentificationTest" />
		<rdf:type rdf:resource="&test;PositiveEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">somevaluesfrom2bnode</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bijan Parsia</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shows that a BNode is an existential variable.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Approved" />
		<test:semantics rdf:resource="&test;DIRECT" />
		<test:semantics rdf:resource="&test;RDF-BASED" />
		<test:species rdf:resource="&test;FULL" />
		<test:species rdf:resource="&test;DL" />
		<test:profile rdf:resource="&test;EL" />
		<test:rdfXmlConclusionOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"  
          xmlns:ex="http://example.org/"
          xmlns:owl="http://www.w3.org/2002/07/owl#"
          xml:base="http://example.org/"&gt;
  &lt;owl:Ontology /&gt;
  &lt;owl:ObjectProperty rdf:about="p"/&gt;
  &lt;rdf:Description rdf:about="a"&gt;
    &lt;ex:p&gt;&lt;rdf:Description/&gt;&lt;/ex:p&gt; 
  &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
		<test:rdfXmlPremiseOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"  
          xmlns:ex="http://example.org/"
          xmlns:owl="http://www.w3.org/2002/07/owl#"
          xml:base="http://example.org/"&gt;
  &lt;owl:Ontology /&gt;
  &lt;owl:ObjectProperty rdf:about="p"/&gt;
  &lt;rdf:Description rdf:about="a"&gt;
        &lt;rdf:type&gt;
            &lt;owl:Restriction&gt;
                &lt;owl:onProperty rdf:resource="p"/&gt;
                &lt;owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/&gt;
            &lt;/owl:Restriction&gt;
        &lt;/rdf:type&gt;
    &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
	</test:TestCase>
	<owl:NegativePropertyAssertion>
		<owl:sourceIndividual rdf:resource="http://owl.semanticweb.org/id/Somevaluesfrom2bnode" />
		<owl:assertionProperty rdf:resource="&test;profile" />
		<owl:targetIndividual rdf:resource="&test;QL" />
	</owl:NegativePropertyAssertion>
