         &lt;/rdf:first&gt;
         &lt;rdf:rest rdf:resource = "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/&gt;
       &lt;/rdf:List&gt;
     &lt;/owl:unionOf&gt;
   &lt;/owl:Class&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
