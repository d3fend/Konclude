	<test:TestCase rdf:about="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2Dmiscellaneous-2D302-2DDirect">
		<rdf:type rdf:resource="&test;ProfileIdentificationTest" />
		<rdf:type rdf:resource="&test;PositiveEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WebOnt-miscellaneous-302-Direct</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jeremy J. Carroll</test:creator>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mike Smith</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A version of WebOnt-miscellaneous-302 applicable under the Direct Semantics, in which the annotation in the entailed ontology is not considered.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Approved" />
		<test:semantics rdf:resource="&test;DIRECT" />
		<test:alternativeSemanticsTest rdf:resource="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2Dmiscellaneous-2D302" />
		<test:species rdf:resource="&test;FULL" />
		<test:species rdf:resource="&test;DL" />
		<test:profile rdf:resource="&test;EL" />
		<test:profile rdf:resource="&test;QL" />
		<test:rdfXmlConclusionOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:first="http://www.w3.org/2002/03owlt/miscellaneous/premises302#"
    xml:base="http://www.w3.org/2002/03owlt/miscellaneous/nonconclusions302" &gt;

&lt;owl:Ontology/&gt;

&lt;owl:AnnotationProperty rdf:about="premises302#prop" /&gt;

&lt;owl:Thing rdf:about="premises302#a"&gt;
   &lt;first:prop&gt;bar&lt;/first:prop&gt;
&lt;/owl:Thing&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
		<test:rdfXmlPremiseOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:first="http://www.w3.org/2002/03owlt/miscellaneous/premises302#"
    xml:base="http://www.w3.org/2002/03owlt/miscellaneous/premises302" &gt;

&lt;owl:Ontology/&gt;
&lt;owl:AnnotationProperty rdf:ID="prop" /&gt;
&lt;owl:Thing rdf:about="#a"&gt;
   &lt;first:prop&gt;foo&lt;/first:prop&gt;
&lt;/owl:Thing&gt;

&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
	</test:TestCase>
	<owl:NegativePropertyAssertion>
		<owl:sourceIndividual rdf:resource="http://owl.semanticweb.org/id/TestCase-3AWebOnt-2Dmiscellaneous-2D302-2DDirect" />
		<owl:assertionProperty rdf:resource="&test;semantics" />
		<owl:targetIndividual rdf:resource="&test;RDF-BASED" />
	</owl:NegativePropertyAssertion>
