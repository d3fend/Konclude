    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"&gt;
  &lt;rdf:Description rdf:about="http://www.example.org#s2"&gt;
    &lt;ex:p2 rdf:resource="http://www.example.org#o2"/&gt;
  &lt;/rdf:Description&gt;
  &lt;rdf:Description rdf:about="http://www.example.org#s1"&gt;
