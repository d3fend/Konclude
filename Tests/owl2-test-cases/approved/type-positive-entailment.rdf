	<test:TestCase rdf:about="http://owl.semanticweb.org/id/Rdfbased-2Dsem-2Drestrict-2Dmaxqcr-2Dinst-2Dobj-2Done">
		<rdf:type rdf:resource="&test;ProfileIdentificationTest" />
		<rdf:type rdf:resource="&test;PositiveEntailmentTest" />
		<rdf:type rdf:resource="&test;ConsistencyTest" />
		<test:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rdfbased-sem-restrict-maxqcr-inst-obj-one</test:identifier>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Michael Schneider</test:creator>
		<test:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kai Mainzer</test:creator>
		<test:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If an individual w is an instance of the max-1-QCR on property p to class c, and if there are triples w p x1 and w p x2, with x1 and x2 being in c, then x1 equals x2.</test:description>
		<test:normativeSyntax rdf:resource="&test;RDFXML" />
		<test:status rdf:resource="&test;Approved" />
		<test:semantics rdf:resource="&test;DIRECT" />
		<test:semantics rdf:resource="&test;RDF-BASED" />
		<test:species rdf:resource="&test;FULL" />
		<test:rdfXmlConclusionOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ex="http://www.example.org#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"&gt;
  &lt;rdf:Description rdf:about="http://www.example.org#x1"&gt;
    &lt;owl:sameAs rdf:resource="http://www.example.org#x2"/&gt;
  &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlConclusionOntology>
		<test:rdfXmlPremiseOntology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ex="http://www.example.org#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"&gt;
  &lt;ex:z rdf:about="http://www.example.org#w"&gt;
    &lt;ex:p&gt;
      &lt;ex:c rdf:about="http://www.example.org#x1"/&gt;
    &lt;/ex:p&gt;
    &lt;ex:p&gt;
      &lt;ex:c rdf:about="http://www.example.org#x2"/&gt;
    &lt;/ex:p&gt;
  &lt;/ex:z&gt;
  &lt;rdf:Description rdf:about="http://www.example.org#z"&gt;
    &lt;owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
    &gt;1&lt;/owl:maxQualifiedCardinality&gt;
    &lt;owl:onProperty rdf:resource="http://www.example.org#p"/&gt;
    &lt;owl:onClass rdf:resource="http://www.example.org#c"/&gt;
  &lt;/rdf:Description&gt;
&lt;/rdf:RDF&gt;</test:rdfXmlPremiseOntology>
	</test:TestCase>
